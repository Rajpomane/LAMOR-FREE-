# Telegram bot token from @BotFather. Do not commit your real token.
BOT_TOKEN=your_telegram_bot_token_here

# MongoDB connection details. Do not commit real credentials.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?appName=Cluster0
DATABASE_NAME=attack_bot

# Admin Telegram user IDs. Separate multiple IDs with commas.
ADMIN_IDS=123456789

# JSON API mode:
# API_URL=https://your-api-domain.com
# API_KEY=your_api_key_here

# URL template API mode (replace placeholders at runtime):
API_URL=TinyREF/1.0
API_KEY=https://example.com/APIv2?key=YOUR_KEY&target=TARGET&port=PORT&duration=TIME&method=METHOD
DEFAULT_ATTACK_METHOD=METHOD
